+    gDarkColors[ThemeColor::Grey200]           = wxColour("#171C28");
+    gDarkColors[ThemeColor::Grey250]           = wxColour("#080A0F");
+    gDarkColors[ThemeColor::LightGreen]        = wxColour("#0F241D");
+}
